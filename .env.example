# Train-ticket-infra — environment configuration
#
# Copy to .env and fill in values before running docker compose up.
# docker compose reads .env automatically from the same directory.

# --------------------------------------------------------------------------- image registry
# Docker Hub namespace and tag for the pre-built train-ticket images.
# After running `make build-all && make push-all` in ./build/, this resolves to
# hdali00/ts-*:latest — the defaults in docker-compose.yml match these values.
REGISTRY=hdali00
TAG=latest

# --------------------------------------------------------------------------- optional: rca-harness integration
# To have train-ticket traces and metrics flow into the rca-harness observability
# stack, both stacks must share a Docker network and the Java services must be
# configured to export OTLP traces.
#
# 1. Add an external network in docker-compose.yml:
#      networks:
#        tt-network: ...
#        obs-network:
#          external: true
#          name: rca-harness_default
#
# 2. Set the OTEL exporter endpoint (if your train-ticket fork has OTEL enabled):
#      OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
#      OTEL_SERVICE_NAME=ts-<service-name>
